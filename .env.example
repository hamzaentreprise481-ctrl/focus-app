# A FOCUS-only Supabase project. Never reuse another product's project or keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Recommended: public HTTPS origin used in password-reset links (else the request host).
FOCUS_SITE_URL=
# Optional verified HTTPS appointment/contact form URL. No fallback email is invented.
FOCUS_DEMO_REQUEST_URL=

# Server-only key used by the evidence-based pedagogical AI. Never expose as NEXT_PUBLIC.
OPENAI_API_KEY=
# Server-only: 32-64 random bytes in hex (openssl rand -hex 32). Signs every analysis the
# server records; the database must hold the same value in focus_private.engine_keys (README).
FOCUS_ANALYSIS_SIGNING_KEY=
# Optional model override for pedagogical analysis.
FOCUS_AI_MODEL=gpt-6-astra
# Optional cost guard: model analyses a teacher may trigger per hour (default 150).
FOCUS_AI_HOURLY_LIMIT=
# Optional: reasoning effort sent to the model: low (default), medium or high.
FOCUS_AI_REASONING_EFFORT=
